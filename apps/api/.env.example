# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
APP_URL=http://localhost:3000

# ── Control-plane Supabase project (the central registry) ─────────────────────
SUPABASE_URL=https://YOUR-CONTROL-PLANE.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase Management API (creates a dedicated project per restaurant) ──────
# Personal access token (spans every org the account owns):
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Primary organization id — https://supabase.com/dashboard/org/_/general
SUPABASE_ORG_ID=
# Free-tier scaling: comma-separated org ids, tried in order. Each free org
# holds 2 projects, so add another org id whenever the pool fills up. Blank =
# use SUPABASE_ORG_ID only (the right choice once the org is on a paid plan).
SUPABASE_ORG_IDS=
SUPABASE_REGION=us-east-1
SUPABASE_PROJECT_PLAN=free

# ── "Connect your Supabase" OAuth app (Model B) ──────────────────────────────
# Register at https://supabase.com/dashboard/account/apps — set the redirect URL
# to the value below. When CLIENT_ID + CLIENT_SECRET are present, checkout parks
# the tenant at status='awaiting_connection' and the owner authorizes our app
# against THEIR own Supabase org; provisioning then runs with their token.
# Leave blank to keep the legacy platform-org flow.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=
SUPABASE_OAUTH_REDIRECT_URI=http://localhost:4000/api/onboarding/connect/callback

# ── Payments ─────────────────────────────────────────────────────────────────
# auto (default): real Stripe when the keys below are set, else a built-in
# simulated payment so onboarding runs end to end with no setup. stripe|mock force it.
PAYMENTS_MODE=auto
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# priceId:tier:interval, comma-separated — required for real Stripe checkout.
STRIPE_PRICE_MAP=

# ── Onboarding ───────────────────────────────────────────────────────────────
ONBOARDING_TOKEN_TTL_MINUTES=30

# ── Email (priority: SMTP -> Resend -> console) ──────────────────────────────
# Gmail SMTP delivers welcome / set-password emails to ANY address.
# SMTP_PASS = a 16-char Gmail App Password (myaccount.google.com/apppasswords,
# requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-website@gmail.com
SMTP_PASS=
EMAIL_FROM=Automation Restaurant <your-website@gmail.com>
SUPPORT_EMAIL=your-website@gmail.com
# Fallback provider if SMTP isn't set:
RESEND_API_KEY=

# ── AI assistant ────────────────────────────────────────────────────────────
# Set one. Gemini has a free tier (aistudio.google.com/apikey) and takes
# priority when both are set. Both blank -> the assistant is disabled.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── Social media (Instagram) ─────────────────────────────────────────────────
# Create a Meta App at developers.facebook.com with Instagram Graph API
# access (instagram_basic, instagram_content_publish, pages_show_list,
# business_management permissions) and register the redirect URI below.
# Both blank -> the Social page stays visible but shows "not configured".
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/social/connect/callback
